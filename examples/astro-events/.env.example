# Origin of the EmDash site hosting Eventual's public JSON API.
# Omit this only when this Astro server shares the EmDash origin.
EVENTUAL_API_ORIGIN=http://127.0.0.1:4322

# Installed plugin ID. Keep "eventual" for a config-managed install. A Registry
# install has a generated ID (r_…), shown in the address of its Events page.
# EVENTUAL_PLUGIN_ID=r_xxxxxxxxxxxxxxxx

# Page language (texts, dates, first day of the week) and the time zone for "this month".
EVENTUAL_LOCALE=en-GB
EVENTUAL_DISPLAY_TIMEZONE=Europe/Amsterdam
