---
import EventBrowser from "@vermeulen.solutions/eventual/astro/EventBrowser.astro";
import { loadEventBrowser } from "@vermeulen.solutions/eventual/astro/events";
import SiteLayout from "../layouts/SiteLayout.astro";
import { EVENTUAL_API_ORIGIN, EVENTUAL_DISPLAY_TIMEZONE, EVENTUAL_LOCALE, EVENTUAL_PLUGIN_ID } from "astro:env/server";

const data = await loadEventBrowser(Astro.url, {
	pluginId: EVENTUAL_PLUGIN_ID,
	origin: EVENTUAL_API_ORIGIN || Astro.url.origin,
	locale: EVENTUAL_LOCALE,
	timeZone: EVENTUAL_DISPLAY_TIMEZONE,
	basePath: "/events",
});
Astro.response.status = data.status;
---

<SiteLayout title={data.pageTitle} lang={data.lang} dir={data.dir} description={data.description}>
	<EventBrowser data={data} />
</SiteLayout>
