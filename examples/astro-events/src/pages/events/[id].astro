---
import EventDetail from "@vermeulen.solutions/eventual/astro/EventDetail.astro";
import { loadEventDetail } from "@vermeulen.solutions/eventual/astro/events";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { EVENTUAL_API_ORIGIN, EVENTUAL_LOCALE, EVENTUAL_PLUGIN_ID } from "astro:env/server";

const data = await loadEventDetail(Astro.url, Astro.params.id, {
	pluginId: EVENTUAL_PLUGIN_ID,
	origin: EVENTUAL_API_ORIGIN || Astro.url.origin,
	locale: EVENTUAL_LOCALE,
	basePath: "/events",
});
Astro.response.status = data.status;
---

<SiteLayout title={data.pageTitle} lang={data.lang} dir={data.dir} description={data.description}>
	<EventDetail data={data}>
		{/* RsvpForm or TicketCheckout go here: see the developer guide. */}
	</EventDetail>
</SiteLayout>
