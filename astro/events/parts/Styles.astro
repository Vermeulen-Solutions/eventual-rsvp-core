<!-- Default look of the event pages. Global (every class is `eventual-` prefixed and scoped under
     .eventual-browser / .eventual-detail) and in the `eventual` cascade layer, so a site's own
     unlayered CSS always wins. Astro includes it once however many components use it. -->
<style is:global>
@layer eventual {
	/* Neutrals follow the text colour around the block, so they suit any background. Accent and
	   status colours follow the page's color-scheme (light-dark()): set `color-scheme: dark` or
	   `light dark` where the block sits on a dark surface, or pass scheme="dark".
	   Override any --eventual-* property on the block or an ancestor. */
	.eventual-browser,
	.eventual-detail {
		--_accent: var(--eventual-primary, light-dark(#075985, #7dd3fc));
		--_on-accent: var(--eventual-on-primary, light-dark(#ffffff, #082f49));
		--_accent-soft: color-mix(in oklch, var(--_accent) 12%, transparent);
		--_accent-faint: color-mix(in oklch, var(--_accent) 7%, transparent);
		--_muted: var(--eventual-text-muted, color-mix(in oklch, currentColor 72%, transparent));
		--_border: var(--eventual-border, color-mix(in oklch, currentColor 14%, transparent));
		--_border-strong: color-mix(in oklch, currentColor 30%, transparent);
		--_surface: var(--eventual-surface, color-mix(in oklch, currentColor 3%, transparent));
		--_surface-strong: color-mix(in oklch, currentColor 7%, transparent);
		--_cancelled: var(--eventual-cancelled, light-dark(#991b1b, #fca5a5));
		--_changed: var(--eventual-changed, light-dark(#92400e, #fcd34d));
		--_error: var(--eventual-error, light-dark(#991b1b, #fca5a5));
		--_radius: var(--eventual-radius, 0.875rem);
		--_control-radius: var(--eventual-control-radius, 0.5rem);
		--_focus: var(--eventual-focus, var(--_accent));
		--_gap: var(--eventual-gap, 1rem);
		container: eventual / inline-size;
		display: grid;
		gap: calc(var(--_gap) * 1.5);
		line-height: 1.5;
	}

	:where(.eventual-browser, .eventual-detail),
	:where(.eventual-browser, .eventual-detail) :where(*, *::before, *::after) {
		box-sizing: border-box;
	}

	/* Grid children may shrink below their content (long words, scrolling strips). */
	:where(.eventual-browser, .eventual-detail, .eventual-controls, .eventual-view, .eventual-group, .eventual-detail__layout, .eventual-detail__panel, .eventual-detail__actions, .eventual-detail__main) > * {
		min-inline-size: 0;
	}

	:where(.eventual-browser, .eventual-detail) :where(h1, h2, h3, h4, h5, h6, p, ul, ol, figure) {
		margin: 0;
	}

	:where(.eventual-browser, .eventual-detail) :where(ul, ol) {
		padding: 0;
		list-style: none;
	}

	:where(.eventual-browser, .eventual-detail) :where(h1, h2, h3, h4, h5, h6) {
		text-wrap: balance;
	}

	:where(.eventual-browser, .eventual-detail) a {
		color: var(--_accent);
		text-decoration-thickness: from-font;
		text-underline-offset: 0.18em;
	}

	:where(.eventual-browser, .eventual-detail) :is(a, button, summary, select, [tabindex]):focus-visible {
		outline: 2px solid var(--_focus);
		outline-offset: 2px;
	}

	:where(.eventual-browser, .eventual-detail) img {
		display: block;
		max-inline-size: 100%;
		block-size: auto;
	}

	.eventual-sr-only {
		position: absolute !important;
		inline-size: 1px;
		block-size: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	/* One line-icon set: 24px grid, 1.75 stroke. */
	.eventual-icon {
		flex: none;
		inline-size: 1.125em;
		block-size: 1.125em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	[dir="rtl"] .eventual-flip {
		transform: scaleX(-1);
	}

	/* A whole card is clickable through its title link; other links sit above it. */
	.eventual-cover {
		color: inherit;
		text-decoration: none;
	}

	.eventual-cover::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.eventual-cover:focus-visible {
		outline: none;
	}

	:is(.eventual-agenda, .eventual-card, .eventual-row):has(.eventual-cover:focus-visible) {
		outline: 2px solid var(--_focus);
		outline-offset: 2px;
	}

	:is(.eventual-agenda, .eventual-card, .eventual-row):hover .eventual-cover {
		text-decoration: underline;
		text-decoration-thickness: from-font;
	}

	.eventual-raise {
		position: relative;
		z-index: 1;
	}

	/* ── Date tile ──────────────────────────────────────────────────────── */
	.eventual-tile {
		display: inline-grid;
		justify-items: center;
		align-content: center;
		gap: 0.125rem;
		min-inline-size: 3.25rem;
		padding: 0.5rem 0.375rem;
		border-radius: var(--_control-radius);
		background: var(--_accent-soft);
		line-height: 1;
		text-align: center;
		font-variant-numeric: tabular-nums;
	}

	.eventual-tile__weekday,
	.eventual-tile__month {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.eventual-tile__weekday {
		color: var(--_accent);
	}

	.eventual-tile__day {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.eventual-tile--stack {
		gap: 0.3125rem;
	}

	.eventual-tile--stack .eventual-tile__day {
		font-size: 1.875rem;
	}

	/* ── Meta lines (time, place, organizer) ────────────────────────────── */
	.eventual-meta-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	.eventual-meta {
		display: flex;
		gap: 0.4375rem;
		align-items: flex-start;
		min-inline-size: 0;
		color: var(--_muted);
		font-size: 0.9375em;
		overflow-wrap: anywhere;
	}

	.eventual-meta > .eventual-icon {
		margin-block-start: 0.1875em;
		color: var(--_accent);
	}

	/* ── Header, view switch, toolbar ───────────────────────────────────── */
	.eventual-browser__header {
		display: grid;
		gap: 0.5rem;
	}

	.eventual-browser__title {
		font-size: clamp(1.75em, 1.4em + 1.5cqi, 2.375em);
		line-height: 1.1;
		letter-spacing: -0.015em;
		overflow-wrap: anywhere;
	}

	.eventual-browser__intro {
		max-inline-size: 60ch;
		color: var(--_muted);
		font-size: 1.0625em;
	}

	.eventual-controls {
		display: grid;
		gap: 0.875rem;
	}

	.eventual-views ul {
		display: flex;
		gap: 0.125rem;
		inline-size: fit-content;
		max-inline-size: 100%;
		padding: 0.25rem;
		overflow-x: auto;
		border: 1px solid var(--_border);
		border-radius: calc(var(--_control-radius) + 0.25rem);
		background: var(--_surface);
		scrollbar-width: thin;
	}

	.eventual-views a {
		display: inline-flex;
		align-items: center;
		min-block-size: 2.25rem;
		padding: 0.25rem 0.875rem;
		border-radius: var(--_control-radius);
		color: var(--_muted);
		font-size: 0.9375em;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}

	/* Narrow blocks: every view stays in sight instead of scrolling. */
	@container eventual (max-width: 36rem) {
		.eventual-views ul {
			flex-wrap: wrap;
			inline-size: auto;
		}
	}

	.eventual-views a:hover {
		background: var(--_surface-strong);
		color: inherit;
	}

	.eventual-views a[aria-current="page"] {
		background: var(--_accent);
		font-weight: 600;
	}

	/* On an inner span: a site's own `a { color }` rule is unlayered, so it beats this layer and
	   would paint the current tab's label in the tab's own colour. */
	.eventual-views a[aria-current="page"] > span {
		color: var(--_on-accent);
	}

	.eventual-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: 0.875rem;
		border-block: 1px solid var(--_border);
	}

	.eventual-months,
	.eventual-months__step,
	.eventual-filter {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}

	.eventual-months__step {
		gap: 0.25rem;
	}

	.eventual-filter label {
		color: var(--_muted);
		font-size: 0.9375em;
	}

	.eventual-select {
		position: relative;
		display: inline-flex;
		align-items: center;
		max-inline-size: 100%;
	}

	.eventual-select select {
		appearance: none;
		min-block-size: 2.5rem;
		max-inline-size: 100%;
		padding-block: 0.25rem;
		padding-inline: 0.75rem 2.25rem;
		border: 1px solid var(--_border-strong);
		border-radius: var(--_control-radius);
		background: transparent;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}

	.eventual-select select:hover {
		background: var(--_surface);
	}

	.eventual-select .eventual-icon {
		position: absolute;
		inset-inline-end: 0.75rem;
		pointer-events: none;
	}

	.eventual-summary {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		color: var(--_muted);
		font-size: 0.9375em;
	}

	.eventual-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-block-size: 2.5rem;
		padding: 0.25rem 1rem;
		border: 1px solid var(--_border-strong);
		border-radius: var(--_control-radius);
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.9375em;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		cursor: pointer;
	}

	.eventual-button:hover {
		background: var(--_surface-strong);
	}

	.eventual-button--primary {
		border-color: var(--_accent);
		background: var(--_accent);
		color: var(--_on-accent);
	}

	.eventual-button--primary:hover {
		background: color-mix(in oklch, var(--_accent) 88%, currentColor);
	}

	.eventual-button--quiet {
		border-color: transparent;
		color: var(--_accent);
	}

	.eventual-button--icon {
		inline-size: 2.5rem;
		padding: 0;
	}

	.eventual-button--icon .eventual-icon {
		inline-size: 1.25em;
		block-size: 1.25em;
	}

	.eventual-months [aria-current="date"] {
		border-color: var(--_accent);
		color: var(--_accent);
	}

	/* ── Notices, badges, tags ──────────────────────────────────────────── */
	.eventual-notice {
		display: grid;
		justify-items: center;
		gap: 0.5rem;
		padding: 3rem 1.5rem;
		border: 1px dashed var(--_border-strong);
		border-radius: var(--_radius);
		text-align: center;
	}

	.eventual-notice > :is(h1, h2, h3) {
		font-size: 1.125em;
	}

	.eventual-notice > p {
		color: var(--_muted);
	}

	.eventual-notice__icon {
		inline-size: 2rem;
		block-size: 2rem;
		color: var(--_accent);
	}

	.eventual-notice--error {
		border-style: solid;
		border-color: var(--_error);
	}

	.eventual-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.125rem 0.5rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1.4;
		vertical-align: 0.15em;
		white-space: nowrap;
	}

	.eventual-badge--cancelled {
		background: color-mix(in oklch, var(--_cancelled) 13%, transparent);
		color: var(--_cancelled);
	}

	.eventual-badge--postponed,
	.eventual-badge--rescheduled {
		background: color-mix(in oklch, var(--_changed) 14%, transparent);
		color: var(--_changed);
	}

	.eventual-badge__detail {
		font-weight: 500;
	}

	.eventual-is-cancelled :is(.eventual-cover, .eventual-month__name),
	.eventual-detail.eventual-is-cancelled .eventual-detail__title {
		text-decoration-line: line-through;
		text-decoration-thickness: from-font;
	}

	.eventual-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.eventual-tags li {
		display: inline-flex;
		align-items: center;
		gap: 0.3125rem;
		padding: 0.125rem 0.625rem;
		border: 1px solid var(--_border);
		border-radius: 999px;
		font-size: 0.8125em;
	}

	.eventual-tags .eventual-icon {
		inline-size: 0.875em;
		block-size: 0.875em;
		color: var(--_muted);
	}

	/* ── Views share a vertical rhythm ──────────────────────────────────── */
	.eventual-view {
		display: grid;
		gap: 2rem;
	}

	.eventual-stack {
		display: grid;
		gap: 0.875rem;
	}

	/* ── List: date column, details, image flush to the edge ────────────── */
	.eventual-agenda {
		position: relative;
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		min-block-size: 7.5rem;
		overflow: hidden;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		transition: border-color 0.15s;
	}

	.eventual-agenda:not(:has(.eventual-agenda__date)) {
		grid-template-columns: minmax(0, 1fr);
	}

	.eventual-agenda--media {
		grid-template-columns: 5.5rem minmax(0, 1fr) minmax(9rem, 14rem);
	}

	.eventual-agenda--media:not(:has(.eventual-agenda__date)) {
		grid-template-columns: minmax(0, 1fr) minmax(9rem, 14rem);
	}

	.eventual-agenda:hover,
	.eventual-card:hover {
		border-color: var(--_border-strong);
	}

	.eventual-agenda__date {
		border-radius: 0;
		border-inline-end: 1px solid var(--_border);
		background: var(--_accent-faint);
	}

	.eventual-agenda__body {
		display: grid;
		gap: 0.5rem;
		align-content: center;
		min-inline-size: 0;
		padding: 1.125rem 1.375rem;
	}

	.eventual-agenda__title,
	.eventual-card__title {
		font-size: 1.1875em;
		font-weight: 650;
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	.eventual-agenda__excerpt,
	.eventual-card__excerpt {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		color: var(--_muted);
		font-size: 0.9375em;
		max-inline-size: 70ch;
	}

	.eventual-agenda__media,
	.eventual-card__media {
		position: relative;
		overflow: hidden;
		background: var(--_surface-strong);
	}

	.eventual-agenda__media img,
	.eventual-card__media img {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		max-inline-size: none;
		object-fit: cover;
	}

	@container eventual (max-width: 40rem) {
		.eventual-agenda--media {
			grid-template-columns: 5.5rem minmax(0, 1fr);
		}

		.eventual-agenda--media:not(:has(.eventual-agenda__date)) {
			grid-template-columns: minmax(0, 1fr);
		}

		.eventual-agenda__media {
			display: none;
		}
	}

	/* Narrow blocks and large text: the date becomes a band above the event. */
	@container eventual (max-width: 26rem) {
		.eventual-agenda,
		.eventual-agenda--media {
			grid-template-columns: minmax(0, 1fr);
			min-block-size: 0;
		}

		.eventual-agenda__date {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			justify-content: start;
			gap: 0.375rem;
			padding: 0.625rem 1.125rem;
			border-inline-end: 0;
			border-block-end: 1px solid var(--_border);
		}

		.eventual-agenda__date .eventual-tile__day {
			font-size: 1.25rem;
		}

		.eventual-agenda__body {
			padding: 1rem 1.125rem;
		}
	}

	/* ── Rows: time column and title, inside one panel per group ────────── */
	.eventual-rows {
		display: grid;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
	}

	.eventual-rows > li + li {
		border-block-start: 1px solid var(--_border);
	}

	.eventual-row {
		position: relative;
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		gap: 0.375rem 1.25rem;
		padding: 1rem 1.25rem;
		border-radius: var(--_radius);
	}

	.eventual-row:hover {
		background: var(--_surface);
	}

	.eventual-row__when {
		display: grid;
		align-content: start;
		gap: 0.125rem;
		font-variant-numeric: tabular-nums;
		line-height: 1.3;
	}

	.eventual-row__date {
		color: var(--_accent);
		font-size: 0.8125em;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.eventual-row__start {
		font-size: 1.0625em;
		font-weight: 650;
	}

	.eventual-row__end {
		color: var(--_muted);
		font-size: 0.8125em;
	}

	.eventual-row__body {
		display: grid;
		gap: 0.3125rem;
		align-content: start;
		min-inline-size: 0;
	}

	.eventual-row__title {
		font-size: 1.0625em;
		font-weight: 650;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}

	@container eventual (max-width: 30rem) {
		.eventual-row {
			grid-template-columns: minmax(0, 1fr);
		}

		.eventual-row__when {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.25rem 0.5rem;
		}

		.eventual-row__start {
			font-size: 0.9375em;
		}
	}

	/* ── Group headers (dates, locations, narrow month) ─────────────────── */
	.eventual-group {
		display: grid;
		gap: 0.875rem;
		scroll-margin-block-start: 1rem;
	}

	.eventual-group:focus {
		outline: none;
	}

	.eventual-group__header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.875rem;
	}

	.eventual-group__title {
		flex: 1 1 12rem;
		font-size: 1.1875em;
		font-weight: 650;
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	.eventual-group__count {
		color: var(--_muted);
		font-size: 0.875em;
	}

	.eventual-group__icon {
		display: inline-grid;
		place-items: center;
		inline-size: 2.75rem;
		block-size: 2.75rem;
		border-radius: 50%;
		background: var(--_accent-soft);
		color: var(--_accent);
	}

	.eventual-group__icon .eventual-icon {
		inline-size: 1.375rem;
		block-size: 1.375rem;
	}

	.eventual-group__link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.9375em;
		font-weight: 600;
	}

	.eventual-group__link .eventual-icon {
		inline-size: 1em;
		block-size: 1em;
	}

	/* ── Cards ──────────────────────────────────────────────────────────── */
	.eventual-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 1.25rem;
	}

	.eventual-card {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr;
		block-size: 100%;
		overflow: hidden;
		border: 1px solid var(--_border);
		border-radius: var(--_radius);
		transition: border-color 0.15s;
	}

	.eventual-card--grid .eventual-card__media {
		aspect-ratio: 16 / 10;
		border-block-end: 1px solid var(--_border);
	}

	.eventual-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.125rem 1.25rem 1.25rem;
	}

	.eventual-card__head {
		display: flex;
		gap: 0.875rem;
		align-items: center;
	}

	.eventual-card__tile {
		align-self: start;
	}

	.eventual-card__body .eventual-meta-group {
		flex-direction: column;
	}

	.eventual-card--grid .eventual-card__excerpt {
		-webkit-line-clamp: 3;
		line-clamp: 3;
	}

	.eventual-card .eventual-tags {
		margin-block-start: auto;
		padding-block-start: 0.25rem;
	}

	/* ── Timeline: date, rail, the day's events ─────────────────────────── */
	.eventual-timeline {
		display: grid;
		--_rail: 2.25rem;
		--_when: 5rem;
	}

	.eventual-timeline__day {
