---
import type { PublicEvent } from "../../feed";
import type { EventBrowserData } from "../index";
import { eventHref } from "../index";
import { eventStartDate, eventTimeRange } from "../grid";
import { safeImageUrl } from "../links";
import { safeWebUrl } from "../../event-details";
import { descriptionExcerpt } from "../description";
import StatusBadge from "./StatusBadge.astro";

interface Props {
	event: PublicEvent;
	data: EventBrowserData;
	level: number;
	/** Show the date block (off inside a list already grouped by date). */
	showDate?: boolean;
	/** Title, time and place only. */
	compact?: boolean;
}

const { event, data, level, showDate = true, compact = false } = Astro.props;
const { text, locale } = data;
const Heading = `h${Math.min(6, level)}` as "h3";
const dateKey = eventStartDate(event);
const date = new Date(`${dateKey}T12:00:00Z`);
const format = (options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(locale, { ...options, timeZone: "UTC" }).format(date);
const imageUrl = compact ? "" : safeImageUrl(event.imageMedia?.src || event.imageUrl, data.origin);
const directionsUrl = safeWebUrl(event.directionsUrl);
const contentLang = event.locale && event.locale.split("-")[0] !== data.lang.split("-")[0] ? event.locale : undefined;
---

<article class:list={["eventual-agenda", compact && "eventual-agenda--compact", event.status === "cancelled" && "eventual-is-cancelled"]} lang={contentLang}>
	{showDate && (
		<time class="eventual-agenda__date" datetime={dateKey}>
			<span aria-hidden="true">{format({ weekday: "short" })}</span>
			<strong aria-hidden="true">{format({ day: "numeric" })}</strong>
			<span aria-hidden="true">{format({ month: "short" })}</span>
			<span class="eventual-sr-only">{format({ dateStyle: "full" })}</span>
		</time>
	)}
	{imageUrl && <img class="eventual-agenda__image" src={imageUrl} alt="" width={event.imageMedia?.width} height={event.imageMedia?.height} loading="lazy" decoding="async" />}
	<div class="eventual-agenda__body">
		<p class="eventual-agenda__time">{event.allDay ? text.event.allDay : eventTimeRange(event, locale)}</p>
		<Heading class="eventual-agenda__title"><a href={eventHref(event, data)}>{event.title}</a> <StatusBadge event={event} text={text} locale={locale} /></Heading>
		{event.location && (
			<p class="eventual-agenda__place">{event.location}{directionsUrl && <> · <a href={directionsUrl} target="_blank" rel="noopener noreferrer">{text.event.directions}<span class="eventual-sr-only"> {text.newTab}</span></a></>}</p>
		)}
		{!compact && event.description && <p class="eventual-agenda__excerpt">{descriptionExcerpt(event.description)}</p>}
	</div>
</article>
