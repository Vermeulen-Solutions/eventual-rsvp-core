---
/** One line-icon set for the event pages: 24px grid, 1.75 stroke, round caps. Always decorative. */
interface Props {
	name: "clock" | "pin" | "calendar" | "calendar-plus" | "external" | "chevron-left" | "chevron-right" | "chevron-down" | "user" | "globe" | "tag" | "rss";
	class?: string;
}

const { name, class: className } = Astro.props;
const paths: Record<Props["name"], string> = {
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	pin: '<path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
	calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
	"calendar-plus": '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4M12 13v5M9.5 15.5h5"/>',
	external: '<path d="M14 4h6v6M20 4l-9 9M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"/>',
	"chevron-left": '<path d="m15 18-6-6 6-6"/>',
	"chevron-right": '<path d="m9 18 6-6-6-6"/>',
	"chevron-down": '<path d="m6 9 6 6 6-6"/>',
	user: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>',
	globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
	tag: '<path d="M3.5 12.6V4.5a1 1 0 0 1 1-1h8.1l8 8a1.5 1.5 0 0 1 0 2.1l-7 7a1.5 1.5 0 0 1-2.1 0z"/><circle cx="8" cy="8" r="1.25"/>',
	rss: '<path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"/><circle cx="6" cy="18" r="1.25"/>',
};
const flip = name === "chevron-left" || name === "chevron-right";
---

<svg class:list={["eventual-icon", flip && "eventual-flip", className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={paths[name]} />
