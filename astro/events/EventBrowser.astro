---
/**
 * The events page body: view switch, month navigation, category filter and one of seven views.
 * Render it inside your own layout with data from `loadEventBrowser` (which also gives the HTTP
 * status and the page title). Styles: ./parts/Styles.astro, in the `eventual` cascade layer.
 */
import type { EventBrowserData } from "./index";
import { eventHref } from "./index";
import { eventTimeRange } from "./grid";
import AgendaItem from "./parts/AgendaItem.astro";
import EventCard from "./parts/EventCard.astro";
import StatusBadge from "./parts/StatusBadge.astro";
import Styles from "./parts/Styles.astro";

interface Props {
	data: EventBrowserData;
	/** Level of the page heading (1 on an events page, 2 inside another page). */
	headingLevel?: 1 | 2;
	/** Page heading; default "Events in <month>". */
	title?: string;
	/** Text under the heading; false for none. */
	intro?: string | false;
	/** ID of the root element (a target for skip links). */
	id?: string;
	/** Colour scheme of this block; default: the page's. */
	scheme?: "light" | "dark" | "light dark";
	showFilter?: boolean;
	showViewSwitch?: boolean;
	class?: string;
}

const { data, headingLevel = 1, title, intro, id = "eventual-events", scheme, showFilter = true, showViewSwitch = true, class: className } = Astro.props;
const { text, state, locale } = data;
const H1 = `h${headingLevel}` as "h1";
const H2 = `h${headingLevel + 1}` as "h2";
const H3 = `h${headingLevel + 2}` as "h3";
const level3 = headingLevel + 2;
const fullDate = new Intl.DateTimeFormat(locale, { dateStyle: "full", timeZone: "UTC" });
const count = data.events.length;
const filterCategories = state.category && !data.categories.includes(state.category) ? [state.category, ...data.categories] : data.categories;
const viewHeading = state.view === "month" || state.view === "list" || state.view === "cards" || state.view === "dates"
	? text.month.events(data.monthTitle)
	: `${text.views[state.view]}: ${data.monthTitle}`;
---

<Styles />
<section id={id} class:list={["eventual-browser", className]} lang={data.lang} dir={data.dir} style={scheme ? `color-scheme: ${scheme}` : undefined} aria-labelledby={`${id}-title`}>
	<header class="eventual-browser__header">
		<div>
			<H1 id={`${id}-title`} class="eventual-browser__title">{title ?? text.month.events(data.monthTitle)}</H1>
			{intro !== false && <p class="eventual-browser__intro">{intro ?? text.intro}</p>}
		</div>
		{showViewSwitch && data.views.length > 1 && (
			<nav class="eventual-views" aria-label={text.views.label}>
				<ul>
					{data.views.map((item) => <li><a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a></li>)}
				</ul>
			</nav>
		)}
	</header>

	<div class="eventual-toolbar">
		<nav class="eventual-months" aria-label={text.month.navigation}>
			<a class="eventual-button eventual-button--icon" href={data.previous.href}>
				<svg viewBox="0 0 24 24" aria-hidden="true" class="eventual-flip"><path d="m15 18-6-6 6-6" /></svg>
				<span class="eventual-sr-only">{data.previous.label}</span>
			</a>
			<a class="eventual-button" href={data.current.href} aria-current={data.current.isCurrent ? "date" : undefined}>{data.current.label}</a>
			<a class="eventual-button eventual-button--icon" href={data.next.href}>
				<svg viewBox="0 0 24 24" aria-hidden="true" class="eventual-flip"><path d="m9 18 6-6-6-6" /></svg>
				<span class="eventual-sr-only">{data.next.label}</span>
			</a>
		</nav>
		{showFilter && (
			<form method="get" class="eventual-filter">
				<input type="hidden" name="month" value={state.month} />
				<input type="hidden" name="view" value={state.view} />
				<label for={`${id}-category`}>{text.filter.label}</label>
				<select id={`${id}-category`} name="category">
					<option value="">{text.filter.all}</option>
					{filterCategories.map((category) => <option value={category} selected={category === state.category}>{category}</option>)}
				</select>
				<button type="submit" class="eventual-button eventual-button--primary">{text.filter.apply}</button>
			</form>
		)}
	</div>

	<p class="eventual-summary">
		<span>{text.count(count)}</span>
		{state.category && <> · <span>{text.filter.active(state.category)}</span> · <a href={data.clearHref}>{text.filter.clear}</a></>}
	</p>

	{data.status === 502 ? (
		<div class="eventual-notice eventual-notice--error" role="alert">
			<H2>{text.notice.unavailable}</H2>
			<p>{text.notice.unavailableDetail}</p>
			<p><a class="eventual-button" href={data.views.find((item) => item.current)?.href ?? "?"}>{text.notice.tryAgain}</a></p>
		</div>
	) : count === 0 ? (
		<div class="eventual-notice">
			<H2>{state.category ? text.notice.emptyFiltered : text.notice.empty}</H2>
			{state.category && <p><a href={data.clearHref}>{text.filter.clear}</a></p>}
		</div>
	) : (
		<section class={`eventual-view eventual-view--${state.view}`} aria-labelledby={`${id}-view`}>
			<H2 id={`${id}-view`} class="eventual-sr-only">{viewHeading}</H2>

			{state.view === "list" && (
				<ul class="eventual-stack">
					{data.events.map((event) => <li><AgendaItem event={event} data={data} level={level3} /></li>)}
				</ul>
			)}

			{state.view === "timeline" && (
				<ol class="eventual-timeline">
					{data.events.map((event) => <li><EventCard event={event} data={data} level={level3} variant="timeline" /></li>)}
				</ol>
			)}

			{state.view === "cards" && (
				<ul class="eventual-grid">
					{data.events.map((event) => <li><EventCard event={event} data={data} level={level3} /></li>)}
				</ul>
			)}

			{state.view === "schedule" && (
				<ul class="eventual-stack">
					{data.dateGroups.map((group, index) => (
						<li>
							<details class="eventual-day" open={index === 0}>
								<summary><span class="eventual-day__label">{group.label}</span> <span class="eventual-day__count">{text.count(group.events.length)}</span></summary>
								<ul class="eventual-stack">
									{group.events.map((event) => <li><AgendaItem event={event} data={data} level={level3} showDate={false} compact /></li>)}
								</ul>
							</details>
						</li>
					))}
				</ul>
			)}

			{state.view === "dates" && (
				<>
					<nav class="eventual-datestrip" aria-label={text.dates.jump}>
						<ul>
							{data.dateGroups.map((group) => (
								<li><a href={`#${group.id}`}><span aria-hidden="true">{group.weekday}</span><strong aria-hidden="true">{group.day}</strong><span class="eventual-sr-only">{group.label}</span></a></li>
							))}
						</ul>
					</nav>
					{data.dateGroups.map((group) => (
						<section class="eventual-dategroup" id={group.id} tabindex="-1" aria-labelledby={`${group.id}-title`}>
							<H3 id={`${group.id}-title`}>{group.label}</H3>
							<ul class="eventual-stack">
								{group.events.map((event) => <li><AgendaItem event={event} data={data} level={level3 + 1} showDate={false} compact /></li>)}
							</ul>
						</section>
					))}
				</>
			)}

			{state.view === "locations" && data.locationGroups.map((group, index) => (
				<section class="eventual-place" aria-labelledby={`${id}-place-${index}`}>
					<header class="eventual-place__header">
						<H3 id={`${id}-place-${index}`}>{group.location}</H3>
						{group.directionsUrl && <a href={group.directionsUrl} target="_blank" rel="noopener noreferrer">{text.event.directions}<span class="eventual-sr-only"> {text.newTab}</span></a>}
					</header>
					<ul class="eventual-stack">
						{group.events.map((event) => <li><AgendaItem event={event} data={data} level={level3 + 1} compact /></li>)}
					</ul>
				</section>
			))}

			{state.view === "month" && (
				<>
					<table class="eventual-month">
						<caption class="eventual-sr-only">{viewHeading}</caption>
						<thead>
							<tr>{data.weekdays.short.map((day, index) => <th scope="col"><span aria-hidden="true">{day}</span><span class="eventual-sr-only">{data.weekdays.long[index]}</span></th>)}</tr>
						</thead>
						<tbody>
							{data.weeks.map((week) => (
								<tr>
									{week.map((cell) => (
										<td class:list={["eventual-month__day", !cell.inMonth && "eventual-month__day--outside", cell.date === data.today && "eventual-month__day--today"]}>
											<time datetime={cell.date} aria-current={cell.date === data.today ? "date" : undefined}>
												<span aria-hidden="true">{cell.dayNumber}</span><span class="eventual-sr-only">{fullDate.format(new Date(`${cell.date}T12:00:00Z`))}</span>
											</time>
											{cell.events.length > 0 && (
												<ul class="eventual-month__events">
													{cell.events.map((event) => (
														<li class:list={[event.status === "cancelled" && "eventual-is-cancelled"]}>
															<a href={eventHref(event, data)}>
																<span class="eventual-month__time">{event.allDay ? text.event.allDay : eventTimeRange(event, locale).split(" ")[0]}</span>
																<span class="eventual-month__name">{event.title}</span>
															</a>
															<StatusBadge event={event} text={text} locale={locale} />
														</li>
													))}
												</ul>
											)}
										</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
					<ul class="eventual-month-list eventual-stack" data-narrow-month>
						{data.dateGroups.map((group) => (
							<li>
								<H3 class="eventual-month-list__day">{group.label}</H3>
								<ul class="eventual-stack">
									{group.events.map((event) => <li><AgendaItem event={event} data={data} level={level3 + 1} showDate={false} compact /></li>)}
								</ul>
							</li>
						))}
					</ul>
				</>
			)}
		</section>
	)}

	{data.subscriptionUrl && (
		<p class="eventual-subscribe"><a class="eventual-button" href={data.subscriptionUrl}>{text.calendar.subscribe}</a></p>
	)}
</section>
