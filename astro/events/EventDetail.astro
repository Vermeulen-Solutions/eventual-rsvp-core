---
/**
 * An event's page body. Render it inside your own layout with data from `loadEventDetail`
 * (which also gives the HTTP status, the title and the description for the head). Anything
 * passed as children (for example RsvpForm or TicketCheckout) appears after the description.
 */
import type { EventDetailData } from "./index";
import Icon from "./parts/Icon.astro";
import StatusBadge from "./parts/StatusBadge.astro";
import Styles from "./parts/Styles.astro";

interface Props {
	data: EventDetailData;
	headingLevel?: 1 | 2;
	/** Link back to the events page; false for none. */
	backHref?: string | false;
	showSubscribe?: boolean;
	/** Structured data for search engines (Event JSON-LD). */
	jsonLd?: boolean;
	scheme?: "light" | "dark" | "light dark";
	class?: string;
}

const { data, headingLevel = 1, backHref = data.backHref, showSubscribe = true, jsonLd = true, scheme, class: className } = Astro.props;
const { text, event, locale } = data;
const H1 = `h${headingLevel}` as "h1";
const H2 = `h${headingLevel + 1}` as "h2";
const links = data.calendarLinks;
const contentLang = event?.locale && event.locale.split("-")[0] !== data.lang.split("-")[0] ? event.locale : undefined;
const newTab = { target: "_blank", rel: "noopener noreferrer" };
---

<Styles />
<article class:list={["eventual-detail", className, event?.status === "cancelled" && "eventual-is-cancelled"]} lang={data.lang} dir={data.dir} style={scheme ? `color-scheme: ${scheme}` : undefined}>
	{backHref && <p class="eventual-detail__back"><a href={backHref}><Icon name="chevron-left" />{text.event.back}</a></p>}

	{data.status === 502 ? (
		<div class="eventual-notice eventual-notice--error" role="alert">
			<H1>{text.notice.unavailable}</H1>
			<p>{text.notice.unavailableDetail}</p>
		</div>
	) : !event ? (
		<div class="eventual-notice">
			<Icon name="calendar" class="eventual-notice__icon" />
			<H1>{text.event.details}</H1>
			<p>{text.notice.notFound}</p>
		</div>
	) : (
		<>
			<header class="eventual-detail__header" lang={contentLang}>
				<StatusBadge event={event} text={text} locale={locale} />
				<H1 class="eventual-detail__title">{event.title}</H1>
			</header>

			<div class="eventual-detail__layout">
				<div class="eventual-detail__panel">
					<ul class="eventual-facts">
						<li>
							<Icon name="calendar" />
							<span><time class="eventual-facts__strong" datetime={event.start}>{data.dateText}</time>{data.timeText && <span class="eventual-facts__line">{data.timeText}</span>}</span>
						</li>
						{event.location && (
							<li>
								<Icon name="pin" />
								<span>
									<span class="eventual-facts__strong">{event.location}</span>
									{data.directionsUrl && <a class="eventual-facts__line" href={data.directionsUrl} {...newTab}>{text.event.directions}<Icon name="external" /><span class="eventual-sr-only"> {text.newTab}</span></a>}
								</span>
							</li>
						)}
						{event.organizer && <li><Icon name="user" /><span>{text.event.organizer(event.organizer)}</span></li>}
						{data.websiteUrl && <li><Icon name="globe" /><a href={data.websiteUrl} {...newTab}>{text.event.website}<Icon name="external" /><span class="eventual-sr-only"> {text.newTab}</span></a></li>}
					</ul>

					<ul class="eventual-detail__actions">
						{links && (
							<li>
								<details class="eventual-calmenu">
									<summary class="eventual-button eventual-button--primary"><Icon name="calendar-plus" />{text.calendar.add}<Icon name="chevron-down" class="eventual-calmenu__chevron" /></summary>
									<ul class="eventual-calmenu__options" aria-label={text.calendar.addFor(event.title)}>
										<li><a href={links.google} {...newTab}>{text.calendar.google}<span class="eventual-sr-only"> {text.newTab}</span></a></li>
										<li><a href={links.outlook} {...newTab}>{text.calendar.outlook}<span class="eventual-sr-only"> {text.newTab}</span></a></li>
										<li><a href={links.office365} {...newTab}>{text.calendar.office365}<span class="eventual-sr-only"> {text.newTab}</span></a></li>
										<li><a href={links.ics} download>{text.calendar.ics}</a></li>
									</ul>
								</details>
							</li>
						)}
						{data.onlineUrl && <li><a class="eventual-button" href={data.onlineUrl} {...newTab}>{text.event.joinOnline}<Icon name="external" /><span class="eventual-sr-only"> {text.newTab}</span></a></li>}
						{showSubscribe && data.subscriptionUrl && <li><a class="eventual-button eventual-button--quiet" href={data.subscriptionUrl}><Icon name="rss" />{text.calendar.subscribe}</a></li>}
					</ul>
				</div>

				<div class="eventual-detail__main">
					{data.imageUrl && <img class="eventual-detail__image" src={data.imageUrl} alt={event.imageMedia?.alt ?? ""} width={event.imageMedia?.width} height={event.imageMedia?.height} decoding="async" />}

					{data.descriptionHtml && <div class="eventual-detail__description" lang={contentLang} set:html={data.descriptionHtml} />}

					{event.categories.length > 0 && (
						<section class="eventual-detail__categories" aria-labelledby="eventual-detail-categories">
							<H2 id="eventual-detail-categories" class="eventual-sr-only">{text.event.categories}</H2>
							<ul class="eventual-tags">{event.categories.map((category) => <li><Icon name="tag" />{category}</li>)}</ul>
						</section>
					)}

					<slot />
				</div>
			</div>

			{jsonLd && data.jsonLd && <script type="application/ld+json" set:html={data.jsonLd} />}
		</>
	)}
</article>
