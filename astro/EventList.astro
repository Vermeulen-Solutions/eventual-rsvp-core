---
import type { PublicEvent } from "./feed";
import { eventPageUrl, displayEventDate } from './event-list';
import { buildCalendarLinks } from './event-details';
import { editorText, loadEditorCatalog } from './editor-i18n.mjs';

interface Props {
  events: PublicEvent[];
  basePath?: string;
  heading?: string;
  locale?: string;
  emptyMessage?: string;
  showCalendarLinks?: boolean;
}

const {
  events,
  basePath = "/events",
  heading,
  locale = Astro.currentLocale,
  emptyMessage,
  showCalendarLinks = false,
} = Astro.props;

// Visitor-facing labels follow the page language (catalogs ship with this package).
const uiLocale = locale ?? 'en';
await loadEditorCatalog(uiLocale);
const t = (text: string) => editorText(text, uiLocale);

// Calendar links: the group's name includes the event title, and each link's name is its visible
// text (no aria-label), so speech input and screen readers agree with what is on screen.
function eventUrl(event: PublicEvent): string {
  return eventPageUrl(event, basePath);
}
---

{heading && <h2>{heading}</h2>}
{events.length === 0 ? <p>{emptyMessage ?? t('No events found.')}</p> : (
  <ul class="eventual-list">
    {events.map((event) => {
      const links = showCalendarLinks ? (event.calendarLinks ?? buildCalendarLinks(event)) : null;
      return (
        <li class="eventual-item">
          <a href={eventUrl(event)} class="eventual-title">{event.title}</a>
          {(event.status === 'cancelled' || event.status === 'rescheduled') && <strong class={`eventual-status eventual-status-${event.status}`}>{t(event.status === 'cancelled' ? 'Cancelled' : 'Rescheduled')}</strong>}
          <time datetime={event.start} class="eventual-time">{displayEventDate(event, locale ?? event.locale ?? 'en-GB')}</time>
          {(event.venue?.name || event.location) && <span class="eventual-location">{event.venue?.name || event.location}</span>}
          {links && (
            <div class="eventual-calendar-links" role="group" aria-label={`${t('Add to calendar')}: ${event.title}`}>
              <a href={links.google} target="_blank" rel="noopener noreferrer" class="eventual-cal-btn eventual-cal-google">Google</a>
              <a href={links.outlook} target="_blank" rel="noopener noreferrer" class="eventual-cal-btn eventual-cal-outlook">Outlook</a>
              <a href={links.office365} target="_blank" rel="noopener noreferrer" class="eventual-cal-btn eventual-cal-office">Office 365</a>
              <a href={links.ics} download class="eventual-cal-btn eventual-cal-ics">{t('Download iCal file')}</a>
            </div>
          )}
        </li>
      );
    })}
  </ul>
)}

<!-- Light default styles. Global, because every class carries the `eventual-` prefix and sites style
     the list from their own CSS. -->
<style is:global>
  /* In the `eventual` cascade layer: unlayered site CSS always wins, and sites that use layers can
     place `eventual` below their own components layer. */
  @layer eventual {
    /* Neutrals derive from the text colour around the list, so they suit any light or dark
       background. Accent and status colours follow the page's color-scheme (light-dark()), so set
       `color-scheme: dark` (or `light dark`) where the list sits on a dark surface. Override any
       of the --eventual-list-* properties on the list or an ancestor. */
    .eventual-list {
      --_accent: var(--eventual-list-accent, light-dark(#075985, #7dd3fc));
      --_muted: var(--eventual-list-muted, color-mix(in oklch, currentColor 72%, transparent));
      --_border: var(--eventual-list-border, color-mix(in oklch, currentColor 18%, transparent));
      --_radius: var(--eventual-list-radius, 999px);
      --_cancelled: var(--eventual-list-cancelled, light-dark(#991b1b, #fca5a5));
      --_rescheduled: var(--eventual-list-rescheduled, light-dark(#92400e, #fcd34d));
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .eventual-item {
      display: grid;
      grid-template-columns: minmax(0, auto) 1fr;
      align-items: baseline;
      gap: 0.25rem 0.625rem;
      padding-block: 0.875rem;
      border-block-start: 1px solid var(--_border);
    }

    .eventual-item:first-child {
      border-block-start: 0;
      padding-block-start: 0;
    }

    .eventual-title {
      grid-column: 1;
      font-weight: 600;
      font-size: 1.0625em;
      line-height: 1.35;
      color: var(--_accent);
      text-decoration-line: underline;
      text-decoration-thickness: from-font;
      text-underline-offset: 0.18em;
      overflow-wrap: anywhere;
    }

    .eventual-title:hover {
      text-decoration-thickness: 2px;
    }

    .eventual-status {
      grid-column: 2;
      justify-self: start;
      padding: 0.0625rem 0.5rem;
      border: 1px solid currentColor;
      border-radius: var(--_radius);
      font-size: 0.8125em;
      font-weight: 600;
      line-height: 1.5;
    }

    .eventual-status-cancelled {
      color: var(--_cancelled);
    }

    .eventual-status-rescheduled {
      color: var(--_rescheduled);
    }

    .eventual-time,
    .eventual-location,
    .eventual-calendar-links {
      grid-column: 1 / -1;
    }

    .eventual-time,
    .eventual-location {
      color: var(--_muted);
      font-size: 0.9375em;
    }

    .eventual-calendar-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin-block-start: 0.375rem;
    }

    .eventual-cal-btn {
      display: inline-flex;
      align-items: center;
      min-block-size: 1.75rem;
      padding: 0.125rem 0.75rem;
      border: 1px solid var(--_border);
      border-radius: var(--_radius);
      color: var(--_accent);
      font-size: 0.875em;
      line-height: 1.3;
      text-decoration: none;
    }

    .eventual-cal-btn:hover {
      border-color: var(--_accent);
      background: color-mix(in oklch, var(--_accent) 10%, transparent);
    }

    .eventual-title:focus-visible,
    .eventual-cal-btn:focus-visible {
      outline: 2px solid var(--_accent);
      outline-offset: 2px;
    }
  }
</style>
